# ==============================================================================
# Plantilla de variables de entorno - Sistema Inteligente de Reclutamiento
# ==============================================================================
# Copiar este archivo a ".env" (mismo directorio) y reemplazar los valores de
# ejemplo por valores propios ANTES de levantar los contenedores. El archivo
# ".env" real NUNCA debe subirse a un repositorio (agregarlo a .gitignore).
# ==============================================================================

# --- Base de datos PostgreSQL (usada internamente por n8n) ---
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=cambia_esta_clave_por_una_segura
POSTGRES_DB=n8n_db

# --- Autenticación de la interfaz web de n8n (http://localhost:5678) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia_esta_clave_por_una_segura

# --- Clave de cifrado de credenciales de n8n ---
# Generar una cadena aleatoria larga, por ejemplo con:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=genera_una_clave_aleatoria_larga_y_unica

# --- Host y URL pública de n8n (para el Form Trigger / webhooks) ---
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --- Zona horaria (Ecuador continental) ---
GENERIC_TIMEZONE=America/Guayaquil
